    {
      "id": 11,
      "gridPos": {
        "h": 10,
        "w": 10,
        "x": 0,
        "y": 14
      },
      "type": "piechart",
      "title": "Time Allocation (Session Breakdown)",
      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "InfluxDB"
          },
          "query": "from(bucket: \"sensors\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"camera\")\n  |> filter(fn: (r) => r[\"_field\"] == \"state_code\")\n  |> group(columns: [\"_value\"])\n  |> reduce(fn: (r, accumulator) => ({ count: accumulator.count + 1 }), identity: {count: 0})\n  |> map(fn: (r) => ({ _field: if r._value == 0 then \"Distracted\" else if r._value == 1 then \"Working\" else if r._value == 2 then \"Away\" else if r._value == 3 then \"Working (break)\" else if r._value == 4 then \"Distracted (break)\" else \"Away (break)\", _value: r.count }))\n  |> group(columns: [\"_field\"])",
          "refId": "A"
        }
      ],
      "options": {
        "pieType": "donut",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Distracted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Working"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Away"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Working (break)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Distracted (break)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Away (break)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*(Working \\(break\\)|Distracted \\(break\\)|Away \\(break\\)|Distracted|Working|Away).*",
            "renamePattern": "$1"
          }
        }
      ]
